{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"events/","title":"\u4e09\u3001\u91cd\u5927\u4e8b\u4ef6\u7f16","text":"<p>\u8fdb\u8d24\u5386\u53f2\u60a0\u4e45\uff0c\u81ea\u6625\u79cb\u6218\u56fd\u65f6\u671f\u8d77\u4fbf\u6709\u8d24\u4eba\u9a7b\u8db3\uff0c\u5386\u4ee3\u66f4\u662f\u5175\u5bb6\u5fc5\u4e89\u4e4b\u5730\u4e0e\u6587\u4eba\u58a8\u5ba2\u6d41\u8fde\u4e4b\u6240\u3002</p>"},{"location":"events/#_2","title":"\u53e4\u4ee3\u53f2\uff08\u5148\u79e6\u81f3\u6e05\uff09","text":""},{"location":"events/#_3","title":"\u6587\u5316\u8087\u59cb\u4e0e\u5efa\u7f6e\u6cbf\u9769","text":"<ul> <li> <p>\u6fb9\u53f0\u706d\u660e\u8bb2\u5b66 (\u6625\u79cb\u672b\u671f)     \u5b54\u5b50\u5f1f\u5b50\u6fb9\u53f0\u706d\u660e\uff08\u5b57\u5b50\u7fbd\uff09\u5357\u6e38\u81f3\u695a\u5730\uff0c\u4e8e\u8c6b\u7ae0\u90e1\u949f\u9675\u53bf\uff08\u4eca\u8fdb\u8d24\u53bf\u5883\uff09\u949f\u9675\u5c71\u8bbe\u575b\u8bb2\u5b66\uff0c\u4ece\u5b66\u8005\u4e09\u767e\u4f59\u4eba\uff0c\u5f00\u5357\u65b9\u5112\u5b66\u4f20\u64ad\u4e4b\u5148\u6cb3\u3002     &gt; \u5f71\u54cd\uff1a\u626d\u8f6c\u4e86\u4e2d\u539f\u5bf9\u695a\u5730\u201c\u672a\u5f00\u5316\u201d\u7684\u504f\u89c1\u3002\u5357\u660c\u56e0\u6b64\u5f97\u540d\u201c\u8fdb\u8d24\u95e8\u201d\uff0c\u664b\u592a\u5eb7\u5143\u5e74\uff08280\u5e74\uff09\u6539\u949f\u9675\u53bf\u4e3a\u201c\u8fdb\u8d24\u53bf\u201d\uff0c\u610f\u4e3a\u201c\u8fdb\u80fd\u7eb3\u8d24\u201d\u3002</p> </li> <li> <p>\u949f\u9675\u8bbe\u9547\u4e0e\u8bbe\u53bf</p> <ul> <li>\u4e1c\u6c49\u5efa\u5b89\u4e2d\u671f (\u7ea6215\u5e74)\uff1a\u5b59\u6743\u6790\u5357\u660c\u53bf\u4e1c\u5883\u7f6e\u201c\u949f\u9675\u9547\u201d\uff0c\u6cbb\u6240\u8bbe\u4e8e\u5927\u8305\u6e21\uff08\u4eca\u6c11\u548c\u9547\uff09\u3002</li> <li>\u664b\u592a\u5eb7\u5143\u5e74 (280\u5e74)\uff1a\u5347\u949f\u9675\u9547\u4e3a\u949f\u9675\u53bf\u3002</li> <li>\u5510\u6b66\u5fb7\u4e94\u5e74 (622\u5e74)\uff1a\u590d\u7f6e\u949f\u9675\u53bf\uff0c\u4e09\u5e74\u540e\u5e9f\u53bf\u4e3a\u9547\u3002</li> </ul> </li> <li> <p>\u8fdb\u8d24\u590d\u53bf (\u5317\u5b8b\u5d07\u5b81\u4e8c\u5e74 1103\u5e74)     \u671d\u5ef7\u6790\u5357\u660c\u53bf\u5f52\u4ec1\u3001\u5d07\u793c\u7b49\u56db\u4e61\u53ca\u65b0\u5efa\u53bf\u7389\u6eaa\u4e8c\u4e61\uff0c\u4ee5\u8fdb\u8d24\u9547\u4e3a\u6838\u5fc3\u6b63\u5f0f\u7f6e\u8fdb\u8d24\u53bf\uff0c\u53bf\u6cbb\u5b9a\u4e8e\u6c11\u548c\u9547\u3002</p> </li> </ul>"},{"location":"events/#_4","title":"\u540d\u4eba\u8f76\u4e8b\u4e0e\u6587\u8109","text":"<ul> <li>\u6234\u53d4\u4f26\u9690\u5c45 (\u5510\u8d1e\u5143\u56db\u5e74 788\u5e74)     \u629a\u5dde\u523a\u53f2\u6234\u53d4\u4f26\u8f9e\u5b98\u9690\u5c45\u949f\u9675\u5c71\uff0c\u5efa\u201c\u660e\u7ecf\u5802\u201d\u8bb2\u5b66\u3002\u4e61\u4eba\u5c06\u5c71\u66f4\u540d\u4e3a\u201c\u6816\u8d24\u5c71\u201d\uff0c\u5c06\u5c71\u524d\u8d8a\u6eaa\u6613\u540d\u201c\u6da6\u6eaa\u201d\u3002</li> <li>\u738b\u5b89\u77f3\u63a8\u884c\u65b0\u6cd5 (\u5b8b\u7199\u5b81\u4e94\u5e74 1072\u5e74)     \u77e5\u53bf\u5468\u6566\u9890\uff08\u975e\u7406\u5b66\u5468\u5b50\uff09\u4f9d\u738b\u5b89\u77f3\u519c\u7530\u6c34\u5229\u6cd5\uff0c\u52a8\u5458\u6c11\u529b\u4fee\u7b51\u201c\u4e07\u77f3\u9642\u201d\uff08\u540e\u79f0\u8346\u516c\u9642\uff09\uff0c\u4e0d\u4ec5\u89e3\u51b3\u4e86\u6c34\u60a3\uff0c\u8fd8\u4f7f\u8fdb\u8d24\u5c81\u8d4b\u589e\u6536\u7cae\u56db\u5343\u77f3\u3002</li> <li>\u6731\u71b9\u8fc7\u8fdb\u8d24 (\u5b8b\u6df3\u7199\u516b\u5e74 1181\u5e74)     \u6731\u71b9\u9014\u7ecf\u519b\u5c71\u6e56\uff0c\u767b\u6816\u8d24\u5c71\u8bbf\u6234\u53d4\u4f26\u9057\u8ff9\uff0c\u5e76\u8d4b\u8bd7\uff1a\u201c\u6b32\u95ee\u6816\u8d24\u4eba\u53bb\u5904\uff0c\u767d\u4e91\u4f9d\u65e7\u62a4\u5c71\u9688\u3002\u201d</li> <li>\u6c64\u663e\u7956\u9898\u533e (\u660e\u4e07\u5386\u4e8c\u5341\u4e5d\u5e74 1601\u5e74)     \u6c64\u663e\u7956\u5e94\u8fdb\u8d24\u6587\u6e2f\u9547\u5468\u574a\u6751\u8fdb\u58eb\u5468\u732e\u81e3\u4e4b\u8bf7\uff0c\u4eb2\u64b0\u8c31\u5e8f\u5e76\u9898\u5199\u201c\u79d1\u7532\u7b2c\u201d\u77f3\u533e\uff0c\u8be5\u533e\u81f3\u4eca\u5c1a\u5b58\u3002</li> </ul>"},{"location":"events/#_5","title":"\u519b\u4e8b\u70fd\u706b","text":"<ul> <li>\u6731\u5143\u748b\u5927\u6218\u9648\u53cb\u8c05 (\u5143\u81f3\u6b63\u4e8c\u5341\u4e09\u5e74 1363\u5e74)     \u9131\u9633\u6e56\u5927\u6218\u671f\u95f4\uff0c\u9648\u53cb\u8c05\u66fe\u5728\u8fdb\u8d24\u6587\u6865\u6e2f\u8bbe\u201c\u897f\u4ed3\u201d\u56e4\u7cae\uff0c\u88ab\u5f53\u5730\u4e49\u519b\u9996\u9886\u590f\u8ba9\u4e00\u711a\u6bc1\u3002\u6731\u5143\u748b\u5229\u7528\u8fdb\u8d24\u6e14\u6c11\u732e\u7684\u6c34\u6587\u56fe\uff0c\u5728\u6cfe\u6c5f\u5957\u3001\u9a6c\u5bb6\u6e7e\u7b49\u5730\u8bbe\u4f0f\u3002\u6700\u7ec8\u9648\u53cb\u8c05\u5728\u8fdb\u8d24\u5317\u5883\u6c34\u57df\u4e2d\u6d41\u77e2\u8eab\u4ea1\uff0c\u6731\u5143\u748b\u53d6\u5f97\u51b3\u5b9a\u6027\u80dc\u5229\u3002</li> <li>\u592a\u5e73\u519b\u93d6\u6218\u8fdb\u8d24 (\u6e05\u540c\u6cbb\u5e74\u95f4)     1862\u5e74\u81f31864\u5e74\uff0c\u592a\u5e73\u519b\u674e\u4e16\u8d24\u90e8\u3001\u9ec4\u6587\u91d1\u90e8\u66fe\u4e24\u6b21\u653b\u514b\u8fdb\u8d24\u53bf\u57ce\u3002\u6e05\u519b\u4e0e\u592a\u5e73\u519b\u5728\u519b\u5c71\u6e56\u3001\u6816\u8d24\u5c71\u7b49\u5730\u6fc0\u6218\uff0c\u5bfc\u81f4\u201c\u57ce\u57a3\u5d29\u6bc1\u5341\u4e4b\u4e03\uff0c\u5b66\u5bab\u4ec5\u5b58\u5927\u6210\u6bbf\u9636\u77f3\u201d\u3002</li> </ul>"},{"location":"events/#_6","title":"\u57fa\u7840\u8bbe\u65bd\u4e0e\u8d4b\u7a0e","text":"<ul> <li>\u7a0b\u5149\u7538\u7b51\u57ce (\u660e\u5609\u9756\u56db\u5341\u4e00\u5e74 1562\u5e74)     \u77e5\u53bf\u7a0b\u5149\u7538\u4e3a\u9632\u502d\u5bc7\u4e0e\u6d41\u8d3c\uff0c\u4e3b\u6301\u4fee\u7b51\u8fdb\u8d24\u57ce\u5899\u3002\u5468\u957f\u516d\u767e\u4e08\uff0c\u8bbe\u56db\u95e8\u3002\u7a0b\u5149\u7538\u56e0\u52b3\u7d2f\u8fc7\u5ea6\u75c5\u901d\u4e8e\u4efb\u4e0a\uff0c\u767e\u59d3\u5efa\u7960\u796d\u7940\u3002</li> <li>\u8fdb\u8d24\u51cf\u8d4b (\u6e05\u5eb7\u7199\u5341\u4e94\u5e74 1676\u5e74)     \u8fdb\u8d24\u56e0\u660e\u4ee3\u4e08\u91cf\u5931\u8bef\u5bfc\u81f4\u8d4b\u7a0e\u7578\u91cd\u3002\u7ecf\u591a\u4efb\u5b98\u5458\u594f\u8bf7\uff0c\u5eb7\u7199\u5e1d\u7ec8\u964d\u65e8\u8c41\u514d\u8fdb\u8d24\u865a\u7cae\u4e00\u4e07\u4e5d\u5343\u77f3\uff0c\u6c11\u56f0\u5f97\u4ee5\u7f13\u89e3\u3002</li> </ul>"},{"location":"events/#_7","title":"\u8fd1\u73b0\u4ee3\u53f2\uff08\u6c11\u56fd\u81f3\u5efa\u56fd\u540e\uff09","text":""},{"location":"events/#_8","title":"\u9769\u547d\u4e0e\u6297\u6218","text":"<ul> <li>\u5357\u660c\u8d77\u4e49\u519b\u8fc7\u5883 (1927\u5e748\u6708)     \u8d77\u4e49\u519b\u64a4\u79bb\u5357\u660c\u9014\u5f84\u8fdb\u8d24\u3002\u6731\u5fb7\u7387\u90e8\u9014\u7ecf\u674e\u6e21\u9547\uff0c\u53d7\u5230\u6c11\u4f17\u70ed\u70c8\u6b22\u8fce\uff0c\u674e\u6e21\u9152\u574a\u8001\u677f\u4ee5\u6b64\u9152\u6170\u52b3\u7ea2\u519b\u3002\u8fdb\u8d24\u7c4d\u9752\u5e74\uff08\u5982\u5434\u96f7\u9e23\u7b49\uff09\u968f\u519b\u53c2\u6218\u3002</li> <li>\u65e5\u519b\u66b4\u884c\u4e0e\u6297\u6218 (1939-1942)     \u65e5\u519b\u591a\u6b21\u8f70\u70b8\u8fdb\u8d24\uff0c\u5236\u9020\u4e86\u201c\u6881\u5bb6\u6e21\u60e8\u6848\u201d\u3001\u201c\u6e29\u5bb6\u5733\u60e8\u6848\u201d\u548c\u201c\u7f57\u6eaa\u8857\u5927\u8f70\u70b8\u201d\u30021942\u5e74\u6d59\u8d63\u4f1a\u6218\u671f\u95f4\uff0c\u65e5\u519b\u5728\u9648\u5bb6\u6751\u3001\u5929\u4e3b\u5802\u7b49\u5730\u8fdb\u884c\u5c60\u6740\u3002\u8fdb\u8d24\u4eba\u6c11\u79ef\u6781\u914d\u5408\u56fd\u519b\u5728\u519b\u5c71\u6e56\u6c34\u7f51\u963b\u51fb\u65e5\u519b\uff0c\u5e76\u81ea\u6bc1\u6e29\u5733\u5eb7\u5c71\u5f39\u836f\u5e93\u4ee5\u9632\u8d44\u654c\u3002</li> </ul>"},{"location":"events/#_9","title":"\u653f\u6cbb\u4e0e\u5efa\u8bbe","text":"<ul> <li>\u6d59\u8d63\u94c1\u8def\u901a\u8f66 (1936\u5e74)     \u6d59\u8d63\u94c1\u8def\u7389\u5c71\u81f3\u5357\u660c\u6bb5\u901a\u8f66\uff0c\u8fdb\u8d24\u7ad9\u542f\u7528\u3002\u8fd9\u4e0d\u4ec5\u662f\u8fdb\u8d24\u73b0\u4ee3\u4ea4\u901a\u7684\u5f00\u7aef\uff0c\u4e5f\u6781\u5927\u5730\u4fc3\u8fdb\u4e86\u674e\u6e21\u9152\u3001\u6587\u6e2f\u6bdb\u7b14\u7b49\u7279\u4ea7\u7684\u5916\u9500\u3002</li> <li>\u8fdb\u8d24\u89e3\u653e (1949\u5e745\u670816\u65e5)     \u4e2d\u56fd\u4eba\u6c11\u89e3\u653e\u519b\u4e8c\u91ce\u56db\u5175\u56e2\u5341\u4e09\u519b\u4e09\u5341\u4e03\u5e08\u5175\u4e0d\u8840\u5203\u8fdb\u5165\u8fdb\u8d24\u53bf\u57ce\uff0c\u5ba3\u544a\u8fdb\u8d24\u89e3\u653e\u30025\u670818\u65e5\uff0c\u4e2d\u5171\u8fdb\u8d24\u53bf\u59d4\u4e0e\u53bf\u4eba\u6c11\u653f\u5e9c\u6b63\u5f0f\u6210\u7acb\u3002</li> </ul>"},{"location":"events/#_10","title":"\u91cd\u8981\u89c6\u5bdf","text":"<ul> <li>\u9093\u5c0f\u5e73\u5230\u8fdb\u8d24 (1973\u5e742\u6708)     \u9093\u5c0f\u5e73\u5728\u6c5f\u897f\u76d1\u7ba1\u52b3\u52a8\u671f\u95f4\uff0c\u4e13\u7a0b\u8d74\u8fdb\u8d24\u53bf\u201c\u4e94\u4e03\u201d\u5e72\u6821\uff08\u539f\u53bf\u59d4\u62db\u5f85\u6240\uff09\u770b\u671b\u5176\u79d8\u4e66\u738b\u745e\u6797\u3002\u4ed6\u5728\u8fdb\u8d24\u505c\u7559\u4e86\u7ea65\u5c0f\u65f6\uff0c\u5e76\u5728\u5348\u5bb4\u65f6\u5173\u5207\u8be2\u95ee\u4e86\u8fdb\u8d24\u7684\u519c\u4e1a\u751f\u4ea7\u548c\u519c\u6c11\u751f\u6d3b\u60c5\u51b5\uff0c\u7559\u4e0b\u4e86\u201c\u76fc\u8001\u8868\u8fc7\u597d\u65e5\u5b50\u201d\u7684\u6bb7\u5207\u671f\u671b\u3002</li> </ul>"},{"location":"geography/","title":"\u4e8c\u3001\u5730\u7406\u73af\u5883\u7f16","text":""},{"location":"geography/#_2","title":"\u81ea\u7136\u73af\u5883","text":""},{"location":"geography/#_3","title":"\u533a\u4f4d","text":"<p>\u8fdb\u8d24\u53bf\u4f4d\u4e8e\u6c5f\u897f\u7701\u4e2d\u90e8\uff0c\u9131\u9633\u6e56\u5357\u5cb8\uff0c\u629a\u6cb3\u4e0e\u4fe1\u6cb3\u7684\u4e0b\u6e38\u3002\u5730\u7406\u5750\u6807\u662f\u5317\u7eac28\u00b009\u201941\u201d-28\u00b046\u201913\u201d\uff0c\u4e1c\u7ecf116\u00b001\u201915\u201d-116\u00b033\u201938\u201d\u3002\u4e1c\u90bb\u4e1c\u4e61\u53bf\uff0c\u5357\u63a5\u4e34\u5ddd\u533a\uff0c\u897f\u9694\u629a\u6cb3\u4e0e\u4e30\u57ce\u5e02\u3001\u5357\u660c\u53bf\u76f8\u671b\uff0c\u5317\u4ee5\u6768\u574a\u6e56\u3001\u4fe1\u6cb3\u4e3a\u754c\u4e0e\u4f59\u5e72\u53bf\u6bd7\u90bb\u3002\u53bf\u57ce\u6c11\u548c\u9547\uff0c\u8ddd\u5357\u660c\u5e0260\u516c\u91cc\u3002</p>"},{"location":"geography/#_4","title":"\u5730\u8d28\u4e0e\u5730\u8c8c","text":"<p>\u5730\u8d28 \u672c\u53bf\u4ee5\u5143\u53e4\u754c\u53cc\u6865\u5c71\u7fa4\u6784\u6210\u533a\u57df\u8936\u76b1\u57fa\u5e95\uff0c\u7b2c\u56db\u7eaa\u7ea2\u7c98\u571f\u5e7f\u6cdb\u5206\u5e03\u3002\u5168\u53bf\u7531\u7ea2\u58e4\u53d1\u80b2\u7684\u571f\u58e4\u603b\u9762\u79ef\u4e3a12.4\u4e07\u516c\u9877\uff0c\u5360\u5168\u53bf\u9646\u5730\u9762\u79ef\u768481.12%\u3002</p> <p>\u5730\u8c8c \u5168\u53bf\u5730\u8c8c\u7279\u70b9\u5c5e\u4e18\u9675\u6ee8\u6e56\u5730\u533a\u3002\u5730\u52bf\u7531\u4e1c\u5357\u5411\u897f\u5317\u503e\u659c\uff0c\u670916\u4e2a\u6d77\u62d4100\u7c73\u4ee5\u4e0a\u7684\u4f4e\u4e18\u3002\u6700\u9ad8\u5904\u91d1\u5c71\u5cad\u6d77\u62d4256.9\u7c73\uff0c\u6700\u4f4e\u5904\u5317\u90e8\u6e56\u6d32\u6d77\u62d4\u4ec59\u7c73\u3002\u5883\u5185\u5c71\u4e18\u5730\u7ea6\u536025%\uff0c\u6ee8\u6e56\u5730\u533a\u7ea6\u536067%\uff0c\u897f\u90e8\u51b2\u79ef\u5e73\u539f\u7ea6\u53608%\u3002</p>"},{"location":"geography/#_5","title":"\u5c71\u8109\u4e0e\u5c71\u5cf0","text":"<p>\u5168\u53bf\u6d77\u62d460\u7c73\u4ee5\u4e0a\u7684\u5c71\u8109\u8d70\u5411\u5448\u201c\u4e0d\u201d\u5b57\u578b\u5c55\u5e03\uff0c\u6784\u6210\u5730\u5f62\u9aa8\u67b6\u3002 * \u4e3b\u8981\u5c71\u5cf0\uff1a\u5883\u5185\u6709\u91d1\u5c71\u5cad\u3001\u9ebb\u5c71\u5cad\u3001\u6d41\u5cad\u3001\u94dc\u5cad\u3001\u7f57\u5cad\u3001\u7a91\u80cc\u5cad\u3001\u6d6e\u6e38\u5cad\u3001\u4f0f\u5c71\u5cad\u3001\u9999\u7089\u89c2\u3001\u51f0\u5cad\u5c71\u7b4916\u4e2a\u6d77\u62d4100\u7c73\u4ee5\u4e0a\u7684\u4f4e\u4e18\u3002 * \u6700\u9ad8\u5cf0\uff1a\u91d1\u5c71\u5cad\uff0c\u5750\u843d\u5728\u767d\u5729\u4e61\uff0c\u6d77\u62d4256.9\u7c73\u3002</p>"},{"location":"geography/#_6","title":"\u6cb3\u6d41\u4e0e\u6e56\u6cca","text":"<p>\u6cb3\u6d41 * \u4fe1\u6c5f\uff1a\u6d41\u7ecf\u53bf\u5883\u4e1c\u5317\u90e8\uff0c\u897f\u5927\u6cb3\u4e0b\u6e38\u662f\u672c\u53bf\u548c\u4f59\u5e72\u53bf\u7684\u754c\u6cb3\u3002 * \u629a\u6cb3\uff1a\u6d41\u7ecf\u672c\u53bf\u897f\u5357\u90e8\uff0c\u7cfb\u672c\u53bf\u4e0e\u5357\u660c\u3001\u4e34\u5ddd\u7b49\u53bf\u7684\u754c\u6cb3\uff0c\u5883\u5185\u957f\u5ea655\u516c\u91cc\u3002</p> <p>\u6e56\u6cca * \u519b\u5c71\u6e56\uff1a\u672c\u53bf\u6700\u5927\u7684\u6e56\u6cca\uff0c\u5357\u5317\u957f25\u516c\u91cc\uff0c\u4e1c\u897f\u5bbd\u7ea65\u516c\u91cc\uff0c\u76db\u4ea7\u5927\u95f8\u87f9\u3002 * \u9752\u5c9a\u6e56\uff1a\u53c8\u540d\u82f1\u5c71\u6e56\uff0c\u5206\u4e3a\u5185\u3001\u5916\u9752\u5c9a\u6e56\uff0c\u5916\u6e56\u662f\u4e0e\u5357\u660c\u53bf\u7684\u516c\u5171\u754c\u6e56\u3002 * \u9648\u5bb6\u6e56\uff1a\u4f4d\u4e8e\u519b\u5c71\u6e56\u5317\uff0c\u4e0e\u91d1\u6eaa\u6e56\u76f8\u8fde\u3002 * \u91d1\u6eaa\u6e56\uff1a\u4f4d\u4e8e\u8fdb\u8d24\u5317\u7aef\uff0c\u5c5e\u9131\u9633\u6e56\u7684\u4e00\u90e8\u5206\u3002</p>"},{"location":"geography/#_7","title":"\u6c14\u5019\u7279\u5f81","text":"<p>\u8fdb\u8d24\u5c5e\u4e9a\u70ed\u5e26\u5b63\u98ce\u6e7f\u6da6\u6c14\u5019\uff0c\u96e8\u91cf\u5145\u6c9b\uff0c\u56db\u5b63\u5206\u660e\u3002 * \u6c14\u6e29\uff1a\u5e74\u5e73\u5747\u6c14\u6e29\u4e3a17.7\u2103\u3002\u6781\u7aef\u6700\u9ad8\u6c14\u6e2940.5\u2103 (1988\u5e74)\uff0c\u6781\u7aef\u6700\u4f4e\u6c14\u6e29-12.1\u2103 (1991\u5e74)\u3002 * \u964d\u6c34\uff1a\u5168\u5e74\u5e73\u5747\u964d\u6c34\u91cf\u4e3a1591.1\u6beb\u7c73\uff0c4-6\u6708\u4e3a\u6c5b\u671f\uff0c\u5360\u5168\u5e74\u964d\u6c34\u91cf\u768450%\u3002 * \u65e5\u7167\uff1a7\u6708\u4efd\u65e5\u7167\u6700\u591a\uff0c2\u6708\u4efd\u6700\u5c11\u3002 * \u65e0\u971c\u671f\uff1a\u591a\u5e74\u5e73\u5747\u4e3a282\u5929\u3002</p>"},{"location":"geography/#_8","title":"\u81ea\u7136\u707e\u5bb3","text":"<p>\u8fdb\u8d24\u53bf\u4e3b\u8981\u81ea\u7136\u707e\u5bb3\u6709\u6c34\u707e\u3001\u65f1\u707e\u3001\u66b4\u98ce\u3001\u96f9\u707e\u3001\u4f4e\u6e29\u3001\u51b7\u51bb\u7b49\u3002 * \u6c34\u707e\uff1a\u53d1\u751f\u9891\u7387\u8f83\u9ad8\uff0c\u5e73\u57472~3\u5e74\u4e00\u9047\u30021998\u5e74\u7279\u5927\u6d2a\u6d9d\u707e\u5bb3\u76f4\u63a5\u7ecf\u6d4e\u635f\u5931\u8fbe1.95\u4ebf\u5143\u3002 * \u65f1\u707e\uff1a\u591a\u53d1\u751f\u57287\u6708\u4e4b\u540e\uff08\u4f0f\u65f1\u3001\u79cb\u65f1\uff09\u3002 * \u51b0\u96f9\uff1a\u591a\u5728\u6625\u590f\u5b63\u51fa\u73b0\uff0c2021\u5e743\u6708\u66fe\u9020\u6210\u516d\u4e2a\u4e61\u9547\u53d7\u707e\u3002</p>"},{"location":"geography/#_9","title":"\u81ea\u7136\u8d44\u6e90","text":""},{"location":"geography/#_10","title":"\u77ff\u85cf","text":"<ul> <li>\u91d1\u5c5e\u77ff\uff1a\u5206\u5e03\u6709\u8d64\u94c1\u77ff\uff08\u6c60\u6eaa\u3001\u6c11\u548c\uff09\u3001\u9530\u77ff\uff08\u8859\u524d\u3001\u6349\u725b\u5c97\uff09\u3001\u94b4\u77ff\uff08\u949f\u9675\uff09\u3001\u91d1\u77ff\uff08\u6c60\u6eaa\u3001\u8859\u524d\uff09\u7b49\uff0c\u4f46\u591a\u4e3a\u96f6\u661f\u5206\u5e03\u3002</li> <li>\u7164\u77ff\uff1a\u603b\u50a8\u91cf\u7ea6632.8\u4e07\u5428\uff0c\u5206\u5e03\u5728\u949f\u9675\u3001\u6e29\u5733\u7b49\u5730\uff0c\u73b0\u5df2\u591a\u505c\u91c7\u3002</li> </ul>"},{"location":"geography/#_11","title":"\u6c34\u8d44\u6e90","text":"<p>\u5168\u53bf\u6c34\u8d44\u6e90\u4e30\u5bcc\uff0c\u5730\u8868\u6c34\u5e74\u964d\u6c34\u91cf13.8\u4ebf\u7acb\u65b9\u7c73\u3002\u5730\u4e0b\u6c34\u8d28\u4f18\u826f\uff0c20\u4e16\u7eaa90\u5e74\u4ee3\u66fe\u5728\u8305\u5c97\u7b49\u5730\u5f00\u91c7\u77ff\u6cc9\u6c34\u3002</p>"},{"location":"history/","title":"\u4e00\u3001\u653f\u533a\u5efa\u5236\u7f16","text":""},{"location":"history/#_2","title":"\u5386\u53f2","text":""},{"location":"history/#_3","title":"\u91cc\u5c45\u00b7\u574a\u90fd","text":"<p>\u53bf\u57ce\u5341\u4e09\u574a \u53e4\u4ee3\u57ce\u5185\u66f0\u574a\uff0c\u4ea6\u79f0\u516d\u9685\u3002\u5609\u9756\u300a\u53bf\u5fd7\u300b\u8f7d\uff1a\u5728\u57ce\u516d\u9685\uff0c\u4e1c\u9685\u8d24\u884c\u574a\uff0c\u897f\u9685\u4ec1\u884c\u574a\uff0c\u5357\u9685\u79ef\u5584\u574a\uff0c\u5317\u9685\u6298\u6842\u574a\uff0c\u4e2d\u9685\u6e05\u653f\u574a\uff0c\u6b63\u9685\u6c11\u548c\u574a\u3002\u636e\u4e7e\u9686\u300a\u5e9c\u5fd7\u300b\u4e0e\u9053\u5149\u3001\u540c\u6cbb\u300a\u53bf\u5fd7\u300b\u6240\u8f7d\uff0c\u53bf\u57ce\u5206\u4e3a\u5185\u5341\u4e09\u574a\uff1a\u53bf\u6cbb\u5357\u6709\u72b6\u5143\u574a\u3001\u6e05\u653f\u574a\u3001\u79ef\u5584\u574a\u3001\u592a\u5e73\u574a\uff0c\u4e1c\u5357\u6709\u6c11\u548c\u574a\u3001\u8d24\u884c\u574a\u3001\u5927\u6210\u574a\u3001\u4ec1\u5bff\u574a\uff0c\u897f\u5357\u6709\u7530\u6d3d\u574a\uff0c\u5317\u6709\u4e49\u7acb\u574a\u3001\u4e1c\u5317\u6709\u6298\u6842\u574a\uff0c\u897f\u6709\u4ec1\u4e49\u574a\u3001\u4ec1\u884c\u574a\u3002</p> <p>\u8857\u5e02 \u53bf\u57ce\u4e2d\u9053\u8def\uff0c\u7686\u79f0\u4e3a\u8857\u5e02\u3002\u540c\u6cbb\u300a\u53bf\u5fd7\u300b\u8f7d\u53bf\u57ce\u4e2d\u8857\u5e02\u6709\u4e2d\u5927\u8857\u3001\u4e1c\u9854\u8857\u3001\u592a\u5e73\u5df7\u8857\u3001\u5357\u957f\u8857\u3001\u540e\u8857\u3001\u96fe\u5cad\u8857\u3001\u5c11\u5e9c\u6865\u8857\u3001\u82b1\u5df7\u53e3\u8857\u3001\u5b66\u524d\u8857\u3001\u9053\u524d\u8857\u3001\u9a6c\u5bb6\u5df7\u8857\u3001\u82cf\u5bb6\u89d2\u8857\u3001\u6cb3\u95e8\u8857\u3001\u4e2d\u6d32\u8857\u3001\u524d\u6d32\u8857\u3001\u6309\u5bdf\u53f8\u524d\u8857\u5341\u516d\u6761\u8857\u5e02\u3002</p> <p>\u53bf\u5e02 \u540c\u6cbb\u300a\u53bf\u5fd7\u300b\u8f7d\u53bf\u57ce\u56db\u95e8\u5916\u8fd8\u6709\u591a\u4e2a\u8857\u5e02\uff1a\u542f\u548c\u95e8\u5916\u6709\u4e1c\u95e8\u53e3\u5e02\u3001\u79be\u4e86\u53e3\u5e02\u3001\u4e1c\u5173\u8857\u3001\u6349\u725b\u5188\u5e02\u3001\u6c60\u6eaa\u6865\u5e02\u3001\u5357\u9633\u5e02\u3001\u5357\u53f0\u5e02\u3001\u6da6\u6eaa\u5e02\u3001\u6768\u6865\u5e02\u3001\u953a\u9675\u6865\u5e02\u3001\u6f6d\u6d25\u5e02\u3001\u6885\u5e84\u5e02\u3002\u62f1\u6781\u95e8\u5916\u6709\u540e\u6d32\u8857\u3001\u4e03\u91cc\u5188\u5e02\u3001\u820d\u6e90\u5e02\u3001\u8d75\u5bb6\u94fa\u5e02\u3001\u4e09\u9633\u5e02\u3001\u6cfe\u53e3\u65b0\u589f\u5e02\u3001\u5e84\u6eaa\u5e02\u3002\u8fce\u6069\u95e8\u5916\u6709\u7f57\u6eaa\u5e02\u3001\u7389\u5cad\u5e02\u3001\u571f\u574a\u5e02\u3001\u9ec4\u8305\u5188\u5e02\u3002\u7530\u6d3d\u95e8\u5916\u6709\u5f20\u516c\u589f\u5e02\u3001\u767d\u5bb6\u589f\u5e02\u3001\u6728\u67b6\u589f\u5e02\u3001\u4e0b\u57e0\u589f\u5e02\u3002</p> <p>\u90fd\u56fe \u53bf\u57ce\u5916\u66f0\u4e61\uff0c\u6240\u8f96\u4e3a\u90fd\uff0c\u90fd\u4e0b\u8bbe\u56fe\u3002\u5317\u5b8b\u5d07\u5b81\u4e8c\u5e74\uff081103\uff09\uff0c\u7531\u5357\u660c\u53bf\u5212\u5f52\u4ec1\u3001\u5d07\u793c\u3001\u5d07\u4fe1\u3001\u771f\u9690\u56db\u4e61\u548c\u65b0\u5efa\u53bf\u7389\u6eaa\u3001\u4e1c\u897f\u4e8c\u4e61\u5212\u5f52\u8bbe\u7acb\u8fdb\u8d24\u3002\u5317\u5b8b\u5927\u89c2\u4e8c\u5e74\uff081108\uff09\u5c06\u65b0\u5efa\u4e8c\u4e61\u5f52\u8fd8\uff0c\u7531\u5357\u660c\u5212\u94a6\u98ce\u4e61\u8865\u5145\u3002\u8fdb\u8d24\u53bf\u8f96\u4e94\u4e61\uff0c\u4e09\u5341\u516b\u90fd\uff0c\u4e09\u767e\u516d\u5341\u4e00\u56fe\u3002\u660e\u6b66\u5b97\u5e74\u95f4\u6210\u7acb\u4e1c\u4e61\u53bf\u6cbb\uff0c\u4ece\u8fdb\u8d24\u5212\u51fa\u5341\u4e5d\u90fd\u3001\u4e8c\u5341\u90fd\u3001\u4e8c\u5341\u4e00\u90fd\u7ed9\u4e1c\u4e61\u53bf\uff0c\u8fdb\u8d24\u5b9e\u6709\u4e94\u4e61\u3001\u4e09\u5341\u4e94\u90fd\uff0c\u4e09\u767e\u4e09\u5341\u56fe\u3002\u8fd9\u79cd\u5efa\u5236\u4e00\u76f4\u5ef6\u81f3\u6e05\u672b\u6c11\u521d\u3002\u6c11\u56fd\u4e8c\u5341\u4e8c\u5e74\uff081933\uff09\u5f00\u59cb\u5b9e\u884c\u4fdd\u7532\u5236\u5ea6\uff0c\u53bf\u4e0b\u8bbe\u533a\uff0c\u533a\u4e0b\u8bbe\u4fdd\uff0c\u4fdd\u4e0b\u8bbe\u7532\u3002\u56fd\u6c11\u653f\u5e9c\u89c4\u5b9a\uff0c\u6bcf\u4fdd\u4e0d\u5c11\u4e8e\u516d\u7532\uff0c\u4e0d\u8d85\u8fc7\u5341\u4e94\u6237\u3002\u5168\u53bf\u5171\u5206\u56db\u533a\uff0c\u4e8c\u767e\u4e5d\u5341\u4e5d\u4fdd\uff0c\u4e09\u5343\u56db\u767e\u4e03\u5341\u4e09\u7532\u3002</p>"},{"location":"history/#_4","title":"\u653f\u6743\u00b7\u515a\u6d3e","text":""},{"location":"history/#_5","title":"\u53bf\u8859","text":"<p>\u8003\u65e7\u5fd7\uff0c\u8fdb\u8d24\u53bf\u5efa\u7f72\u4e8e\u5b8b\u671d\uff0c\u5efa\u57ce\u4e8e\u660e\u4ee3\u3002\u53bf\u65e7\u65e0\u57ce\u6c60\uff0c\u81f3\u660e\u6b63\u5fb7\u4e94\u5e74(1510)\u5f00\u59cb\u4fee\u7b51\u57ce\u5899\uff0c\u81f3\u516b\u5e74(1513)\u7b51\u5b8c\u571f\u57ce\u3002\u660e\u6e05\u65f6\uff0c\u53bf\u7f72\u8859\u95e8\u4f4d\u4e8e\u62a4\u57ce\u6cb3\u5317\u7684\u540e\u5c97\u6d32\uff0c\u5730\u5904\u4eca\u5317\u95e8\u6865\u5934\u81f3\u4e94\u91cc\u57a6\u6b96\u573a\u4e00\u5e26\u3002\u6c11\u56fd\u65f6\u5728\u6b64\u5efa\u9020\u4e86\u4e2d\u5c71\u7eaa\u5ff5\u5802\uff0c\u6c11\u56fd\u53bf\u653f\u5e9c\u66fe\u642c\u8fc1\u81f3\u6b64\u3002\u6297\u65e5\u6218\u4e89\u65f6\u88ab\u70b8\u6210\u5e9f\u589f\u3002</p>"},{"location":"history/#_6","title":"\u804c\u5b98","text":"<ul> <li>\u660e\u4ee3\uff1a\u8bbe\u77e5\u53bf\u4e00\u4eba\uff0c\u6b63\u4e03\u54c1\uff0c\u6708\u4ff8\u4e03\u77f3\u4e94\u6597\u3002\u53bf\u4e1e\u4e00\u4eba\uff0c\u6b63\u516b\u54c1\uff0c\u6708\u4ff8\u516d\u77f3\u4e94\u6597\u3002\u5112\u5b66\u6559\u8c15\u4e00\u4eba\uff0c\u8bad\u5bfc\u4e8c\u4eba\uff0c\u4ff1\u672a\u5165\u6d41\uff0c\u6708\u4ff8\u4e09\u77f3\u3002\u4e3b\u7c3f\u4e00\u4eba\uff0c\u6b63\u4e5d\u54c1\uff0c\u6708\u4ff8\u4e94\u77f3\u4e94\u6597\u3002\u5178\u53f2\u4e00\u4eba\uff0c\u672a\u5165\u6d41\uff0c\u6708\u4ff8\u4e09\u77f3\u3002</li> <li>\u6e05\u4ee3\uff1a\u8bbe\u77e5\u53bf\u4e00\u5458\uff0c\u6b63\u4e03\u54c1\uff0c\u4ff8\u94f6\u56db\u5341\u4e94\u4e24\uff0c\u96cd\u6b63\u516d\u5e74\uff081728\u5e74\uff09\u589e\u517b\u5ec9\u94f6\u4e00\u5343\u4e8c\u767e\u4e24\u3002\u53bf\u4e1e\u4e00\u5458\uff0c\u6b63\u516b\u54c1\uff0c\u4ff8\u94f6\u56db\u5341\u4e24\u3002</li> </ul>"},{"location":"history/#_7","title":"\u53bf\u516c\u7f72","text":"<p>\u6c11\u56fd\u6210\u7acb\uff0c\u6539\u79f0\u201c\u77e5\u53bf\u201d\u4e3a\u201c\u53bf\u77e5\u4e8b\u201d\uff0c\u6539\u79f0\u201c\u53bf\u8859\u201d\u4e3a\u201c\u53bf\u516c\u7f72\u201d\u3002\u521d\u671f\uff0c\u53bf\u516c\u7f72\u7684\u7ec4\u7ec7\uff0c\u8f83\u4e3a\u7b80\u964b\u7684\uff0c\u53bf\u516c\u7f72\u5185\uff0c\u9664\u53bf\u77e5\u4e8b\u5916\uff0c\u6240\u7528\u7686\u4e3a\u5e55\u50da\u3002\u5317\u4f10\u6210\u529f\u540e\uff0c\u201c\u53bf\u77e5\u4e8b\u201d\u6539\u79f0\u4e3a\u201c\u53bf\u957f\u201d\uff0c\u201c\u53bf\u516c\u7f72\u201d\u6539\u79f0\u4e3a\u201c\u53bf\u653f\u5e9c\u3002\u201d</p>"},{"location":"history/#_8","title":"\u884c\u653f\u533a\u5212","text":"<p>\u5386\u53f2\u6cbf\u9769 \u5b8b\u5d07\u5b81\u4e8c\u5e74\uff081103\uff09\uff0c\u81ea\u5357\u660c\u53bf\u5212\u51fa\u5f52\u4ec1\u3001\u5d07\u793c\u3001\u5d07\u4ec1\u3001\u771f\u9690\u56db\u4e61\uff0c\u53ca\u65b0\u5efa\u53bf\u5212\u51fa\u7389\u6eaa\u4e1c\u3001\u7389\u6eaa\u897f\u4e8c\u4e61\uff0c\u5347\u8fdb\u8d24\u9547\u4e3a\u8fdb\u8d24\u53bf\u3002\u5317\u5b8b\u5927\u89c2\u4e8c\u5e74\uff081108\u5e74\uff09\uff0c\u5c06\u7389\u6eaa\u4e1c\u3001\u7389\u6eaa\u897f\u5f52\u8fd8\u65b0\u5efa\uff0c\u7531\u5357\u660c\u5212\u94a6\u98ce\u4e61\u8865\u4e4b\u3002\u4e61\u4e0b\u6709\u90fd\uff0c\u90fd\u4e0b\u8bbe\u56fe\uff0c\u8fdb\u8d24\u8bbe5\u4e6138\u90fd243\u56fe\u3002</p> <p>\u533a\u57df\u52d8\u754c 1996\u5e74\u56fd\u52a1\u9662\u542f\u52a8\u5168\u56fd\u7701\u3001\u53bf\u4e24\u7ea7\u884c\u653f\u533a\u57df\u754c\u7ebf\u52d8\u5b9a\u5de5\u7a0b\u30021999\u5e74\u5b8c\u6210\u4e0e\u629a\u5dde\u4e1c\u4e61\u53bf\uff08\u73b0\u4e1c\u4e61\u533a\uff09\u8fb9\u754c\u534f\u8bae\u30022018\u5e74\u4f9d\u636e\u300a\u5357\u660c\u5e02\u884c\u653f\u533a\u5212\u56fe\u96c6\u300b\uff082018\u7248\uff09\u66f4\u65b0\u6570\u5b57\u5316\u8fb9\u754c\u3002\u73b0\u8fb9\u754c\u56db\u81f3\uff1a\u4e1c\u4e0e\u629a\u5dde\u5e02\u4e1c\u4e61\u533a\u3001\u4e34\u5ddd\u533a\u63a5\u58e4\uff0c\u4ee5\u629a\u6cb3\u6545\u9053\u4e3a\u5929\u7136\u754c\u6cb3\uff1b\u5357\u6bd7\u90bb\u629a\u5dde\u5e02\u4e34\u5ddd\u533a\u3001\u4e30\u57ce\u5e02\uff0c\u4ee5\u91d1\u5c71\u5cad\u5c71\u8109\u5206\u6c34\u5cad\u4e3a\u754c\uff1b\u897f\u63a5\u5357\u660c\u5e02\u5357\u660c\u53bf\u3001\u9752\u5c71\u6e56\u533a\uff0c\u6cbf\u4fe1\u6c5f\u897f\u652f\u6d41\u4e2d\u5fc3\u7ebf\u5212\u5206\uff1b\u5317\u90bb\u9131\u9633\u6e56\u6c34\u57df\u3002</p>"},{"location":"history/#_9","title":"\u91cd\u70b9\u4e61\u9547\u4ecb\u7ecd","text":"<ul> <li>\u6c11\u548c\u9547\uff1a\u8fdb\u8d24\u53bf\u7684\u57ce\u5173\u9547\uff0c\u4e3a\u53bf\u6cbb\u6240\u5728\u5730\uff0c\u5386\u6765\u662f\u8fdb\u8d24\u7684\u653f\u6cbb\u3001\u7ecf\u6d4e\u3001\u6587\u5316\u4e2d\u5fc3\u30022024\u5e74\u64a4\u9500\u6c11\u548c\u9547\uff0c\u6790\u8bbe\u6c11\u548c\u8857\u9053\u3001\u4e91\u6865\u8857\u9053\u3002</li> <li>\u674e\u6e21\u9547\uff1a\u5343\u5e74\u53e4\u9547\uff0c\u662f\u201c\u6c5f\u5357\u9152\u4e61\u201d\u3001\u201c\u6bdb\u7b14\u4e4b\u4e61\u201d\u3001\u201c\u590f\u5e03\u4e4b\u4e61\u201d\uff0c\u66fe\u4e0e\u666f\u5fb7\u9547\u3001\u9e70\u6f6d\u3001\u6a1f\u6811\u9f50\u540d\uff0c\u5e76\u79f0\u201c\u6c5f\u897f\u56db\u5927\u540d\u9547\u201d\u3002</li> <li>\u6587\u6e2f\u9547\uff1a\u4ee5\u5236\u7b14\u53ca\u76f8\u5173\u6587\u5316\u7528\u54c1\u4ea7\u4e1a\u4e3a\u6838\u5fc3\uff0c\u7d20\u6709\u201c\u534e\u590f\u7b14\u90fd\u201d\u4e4b\u79f0\u3002</li> </ul>"},{"location":"people/","title":"\u56db\u3001\u8457\u540d\u4eba\u7269\u7f16","text":"<p>\u8fdb\u8d24\u53bf\u4eba\u6770\u5730\u7075\uff0c\u81ea\u53e4\u4ee5\u6765\u6d8c\u73b0\u51fa\u4f17\u591a\u6587\u5316\u540d\u6d41\u4e0e\u4ec1\u4eba\u5fd7\u58eb\u3002\u5176\u4e2d\u65e2\u6709\u5b54\u95e8\u4e03\u5341\u4e8c\u8d24\u4e4b\u4e00\u7684\u6fb9\u53f0\u706d\u660e\uff0c\u4e5f\u6709\u201c\u5b8b\u8bcd\u5bb0\u76f8\u201d\u664f\u6b8a\uff0c\u4ee5\u53ca\u8fd1\u4ee3\u6559\u80b2\u5bb6\u674e\u745e\u6e05\u7b49\u3002</p>"},{"location":"people/#_2","title":"\u53e4\u4ee3\u5148\u8d24\u4e0e\u6587\u5316\u540d\u6d41","text":""},{"location":"people/#_3","title":"\u6fb9\u53f0\u706d\u660e","text":"<p>(\u524d512\u5e74\u6216\u524d502\u5e74\u2014\uff1f) \u5b57\u5b50\u7fbd\uff0c\u9c81\u56fd\u6b66\u57ce\u4eba\uff0c\u5b54\u95e8\u4e03\u5341\u4e8c\u8d24\u4e4b\u4e00\u3002 * \u751f\u5e73\uff1a\u65e9\u5e74\u5e08\u4ece\u5b54\u5b50\uff0c\u540e\u5357\u6e38\u5434\u695a\uff0c\u5728\u949f\u9675\uff08\u4eca\u8fdb\u8d24\uff09\u7ed3\u5e90\u8bb2\u5b66\uff0c\u95e8\u5f92\u4e09\u767e\u4f59\u4eba\uff0c\u5f00\u5357\u65b9\u5112\u5b66\u5148\u6cb3\u3002 * \u5f71\u54cd\uff1a\u8fdb\u8d24\u53bf\u540d\u5373\u6e90\u4e8e\u5176\u201c\u8fdb\u80fd\u7eb3\u8d24\u201d\u4e4b\u610f\uff0c\u949f\u9675\u5c71\u4e5f\u56e0\u6b64\u6539\u540d\u6816\u8d24\u5c71\u3002</p>"},{"location":"people/#_4","title":"\u8463\u6e90","text":"<p>\uff08\uff1f~\u7ea6962\u5e74\uff09 \u5b57\u53d4\u8fbe\uff0c\u949f\u9675\uff08\u4eca\u8fdb\u8d24\u897f\u5317\uff09\u4eba\uff0c\u4e94\u4ee3\u5357\u5510\u540d\u753b\u5bb6\u3002 * \u6210\u5c31\uff1a\u6c34\u58a8\u5c71\u6c34\u753b\u5b97\u5e08\uff0c\u88ab\u8a89\u4e3a\u201c\u6587\u4eba\u753b\u201d\u4e4b\u7956\u3002\u4e0e\u5de8\u7136\u5f00\u521b\u4e86\u201c\u6c5f\u5357\u6d3e\u201d\u5c71\u6c34\u753b\u3002\u4ee3\u8868\u4f5c\u6709\u300a\u6f47\u6e58\u56fe\u300b\u300a\u590f\u5c71\u56fe\u300b\u7b49\u3002</p>"},{"location":"people/#_5","title":"\u664f\u6b8a","text":"<p>(991~1055) \u5b57\u540c\u53d4\uff0c\u5317\u5b8b\u8457\u540d\u8bcd\u4eba\u3001\u5bb0\u76f8\uff0c\u8fdb\u8d24\u6587\u6e2f\u6c99\u6cb3\u4eba\u3002 * \u751f\u5e73\uff1a\u795e\u7ae5\u51fa\u8eab\uff0c\u5341\u56db\u5c81\u8d50\u540c\u8fdb\u58eb\u51fa\u8eab\u3002\u5386\u4efb\u8981\u804c\uff0c\u5b98\u81f3\u5bb0\u76f8\uff08\u540c\u4e2d\u4e66\u95e8\u4e0b\u5e73\u7ae0\u4e8b\uff09\u3002 * \u6210\u5c31\uff1a\u201c\u5a49\u7ea6\u6d3e\u201d\u8bcd\u4eba\u521b\u59cb\u4eba\u4e4b\u4e00\uff0c\u540d\u53e5\u201c\u65e0\u53ef\u5948\u4f55\u82b1\u843d\u53bb\uff0c\u4f3c\u66fe\u76f8\u8bc6\u71d5\u5f52\u6765\u201d\u5343\u53e4\u6d41\u4f20\u3002\u4ed6\u5728\u6559\u80b2\u4e0a\u5927\u529b\u5174\u5b66\uff0c\u63d0\u62d4\u4e86\u8303\u4ef2\u6df9\u3001\u6b27\u9633\u4fee\u7b49\u540d\u81e3\u3002</p>"},{"location":"people/#_6","title":"\u664f\u51e0\u9053","text":"<p>(\u7ea61030~\u7ea61106) \u5b57\u53d4\u539f\uff0c\u53f7\u5c0f\u5c71\uff0c\u664f\u6b8a\u7b2c\u4e03\u5b50\u3002 * \u6210\u5c31\uff1a\u5317\u5b8b\u8bcd\u4eba\uff0c\u4e0e\u5176\u7236\u9f50\u540d\u3002\u8bcd\u98ce\u5a49\u4e3d\uff0c\u8457\u6709\u300a\u5c0f\u5c71\u96c6\u300b\u3002</p>"},{"location":"people/#_7","title":"\u8212\u82ac","text":"<p>(1487~1531) \u5b57\u56fd\u88f3\uff0c\u53f7\u6893\u6eaa\uff0c\u8fdb\u8d24\u5317\u5c71\u4eba\u3002 * \u6210\u5c31\uff1a\u660e\u6b63\u5fb7\u5341\u4e8c\u5e74\u72b6\u5143\u3002\u4ee5\u5fe0\u8a00\u76f4\u8c0f\u8457\u79f0\uff0c\u66fe\u56e0\u8c0f\u963b\u6b66\u5b97\u5357\u5de1\u53d7\u5ef7\u6756\uff0c\u4e16\u79f0\u201c\u5fe0\u5b5d\u72b6\u5143\u201d\u3002\u8457\u6709\u300a\u8212\u6587\u8282\u5168\u96c6\u300b\u7b49\u3002</p>"},{"location":"people/#_8","title":"\u674e\u745e\u6e05","text":"<p>(1866~1920) \u5b57\u4ef2\u9e9f\uff0c\u53f7\u6885\u5eb5\uff0c\u8fdb\u8d24\u6e29\u5733\u6768\u6eaa\u4eba\u3002 * \u6210\u5c31\uff1a\u6e05\u672b\u6c11\u521d\u8457\u540d\u6559\u80b2\u5bb6\u3001\u4e66\u6cd5\u5bb6\u3002\u66fe\u4efb\u4e24\u6c5f\u5e08\u8303\u5b66\u5802\u76d1\u7763\uff08\u6821\u957f\uff09\uff0c\u4e0d\u4ec5\u4e66\u753b\u9020\u8be3\u6df1\u539a\uff08\u5f20\u5927\u5343\u4e4b\u5e08\uff09\uff0c\u66f4\u4e3a\u4e2d\u56fd\u73b0\u4ee3\u7f8e\u672f\u6559\u80b2\u5960\u5b9a\u4e86\u57fa\u7840\u3002</p>"},{"location":"people/#_9","title":"\u5386\u4ee3\u4ed5\u5ba6\u4e0e\u5b66\u8005","text":"\u59d3\u540d \u671d\u4ee3 \u7b80\u4ecb \u81e7\u5609\u7337 \u5510\u4ee3 \u771f\u9690\u4e61\u4eba\u3002\u535a\u5b66\u9e3f\u624d\uff0c\u6de1\u6cca\u5b88\u5fd7\uff0c\u5c61\u8f9e\u671d\u5ef7\u5f81\u53ec\uff0c\u9690\u5c45\u4e0d\u4ed5\u3002 \u5f90\u7199 \u4e94\u4ee3 \u949f\u9675\u4eba\u3002\u8457\u540d\u82b1\u9e1f\u753b\u5bb6\uff0c\u5f00\u521b\u201c\u843d\u58a8\u82b1\u201d\u6280\u6cd5\uff0c\u6709\u201c\u9ec4\u5bb6\u5bcc\u8d35\u3001\u5f90\u7199\u91ce\u9038\u201d\u4e4b\u79f0\u3002 \u5de8\u7136 \u5b8b\u521d \u949f\u9675\u4eba\uff0c\u50e7\u4eba\u753b\u5bb6\u3002\u5e08\u6cd5\u8463\u6e90\uff0c\u64c5\u7ed8\u6c5f\u5357\u70df\u5c9a\u6c14\u8c61\uff0c\u4e0e\u8463\u6e90\u5e76\u79f0\u201c\u8463\u5de8\u201d\u3002 \u5434\u5c45\u539a \u5317\u5b8b \u5f20\u516c\u4e61\u4eba\u3002\u5609\u7950\u8fdb\u58eb\uff0c\u79ef\u6781\u63a8\u884c\u738b\u5b89\u77f3\u65b0\u6cd5\uff0c\u5b98\u81f3\u77e5\u67a2\u5bc6\u9662\u4e8b\u3002 \u664f\u6566\u590d \u5357\u5b8b \u664f\u6b8a\u66fe\u5b59\u3002\u521a\u6b63\u4e0d\u963f\uff0c\u66fe\u529b\u4e3b\u6297\u91d1\uff0c\u53cd\u5bf9\u79e6\u6867\u6c42\u548c\u3002 \u4e07\u798f \u660e\u4ee3 \u53bf\u57ce\u4eba\u3002\u5b98\u81f3\u5357\u4eac\u53f3\u90fd\u5fa1\u53f2\uff0c\u4e3a\u5b98\u6e05\u5ec9\uff0c\u4e0d\u754f\u6743\u8d35\u5218\u747e\u3002 \u5f20\u81ec \u660e\u4ee3 \u53bf\u57ce\u4eba\u3002\u5b98\u81f3\u53f3\u90fd\u5fa1\u53f2\uff0c\u66fe\u51c6\u786e\u9884\u5224\u502d\u5bc7\u52a8\u5411\uff0c\u4fdd\u536b\u626c\u5dde\u3002 \u5085\u70af \u660e\u4ee3 \u53bf\u57ce\u4eba\u3002\u5b98\u81f3\u5357\u4eac\u5211\u90e8\u5c1a\u4e66\uff0c\u75be\u6076\u5982\u4ec7\uff0c\u4e0d\u4f9d\u9644\u6743\u8d35\u4e25\u5d69\u3002 \u4e07\u6f6e \u660e\u4ee3 \u53bf\u57ce\u4eba\uff0c\u201c\u6c5f\u897f\u56db\u8c0f\u201d\u4e4b\u4e00\u3002\u56e0\u8c0f\u963b\u6b66\u5b97\u5357\u5de1\u88ab\u524a\u804c\uff0c\u540e\u590d\u8d77\u4efb\u9655\u897f\u5de6\u5e03\u653f\u4f7f\u3002 \u66fe\u94a7 \u660e\u4ee3 \u6cc9\u5cad\u4eba\u3002\u5b98\u81f3\u5de5\u90e8\u53f3\u4f8d\u90ce\uff0c\u66fe\u6297\u758f\u5f39\u52be\u4e25\u5d69\u7236\u5b50\u3002 \u9976\u4f38 \u660e\u4ee3 \u53bf\u57ce\u4eba\u3002\u5b98\u81f3\u5211\u90e8\u5de6\u4f8d\u90ce\uff0c\u56e0\u63ed\u9732\u79d1\u4e3e\u821e\u5f0a\u6848\u88ab\u524a\u804c\uff0c\u540e\u590d\u8d77\u3002 \u5085\u51a0 \u660e\u4ee3 \u53bf\u57ce\u4eba\uff0c\u699c\u773c\u53ca\u7b2c\u3002\u5b98\u81f3\u793c\u90e8\u5c1a\u4e66\u517c\u4e1c\u9601\u5927\u5b66\u58eb\uff0c\u660e\u4ea1\u540e\u6297\u6e05\u6b89\u56fd\u3002 \u80e1\u5947\u4f1f \u660e\u672b \u4e0b\u57e0\u4e61\u4eba\u3002\u6297\u6e05\u540d\u81e3\uff0c\u57ce\u7834\u88ab\u4fd8\u540e\u575a\u8d1e\u4e0d\u5c48\uff0c\u82f1\u52c7\u5c31\u4e49\u3002 \u5085\u5b8f\u70c8 \u6e05\u4ee3 \u6c60\u6eaa\u4e61\u4eba\u3002\u6e05\u521d\u540d\u5c06\uff0c\u5728\u5e73\u5b9a\u201c\u4e09\u85e9\u4e4b\u4e71\u201d\u4e2d\u7acb\u4e0b\u8d6b\u8d6b\u6218\u529f\uff0c\u8c25\u5fe0\u6bc5\u3002"},{"location":"people/#_10","title":"\u8fd1\u73b0\u4ee3\u540d\u4eba\u4e0e\u4e13\u5bb6","text":"<ul> <li>\u6842\u745e\u85e9 (1880~1947)\uff1a\u674e\u6e21\u4eba\u3002\u7559\u5b66\u65e5\u672c\uff0c\u56de\u56fd\u540e\u521b\u529e\u79c1\u7acb\u6842\u6865\u5c0f\u5b66\uff0c\u6bd5\u751f\u81f4\u529b\u4e8e\u4e61\u6751\u6559\u80b2\u3002</li> <li>\u4f55\u7115\u594e (1883~1960)\uff1a\u4e09\u91cc\u4e61\u4eba\u3002\u533b\u5b66\u535a\u58eb\uff0c\u6c5f\u897f\u533b\u5b66\u4e13\u95e8\u5b66\u6821\uff08\u6c5f\u897f\u533b\u5b66\u9662\u524d\u8eab\uff09\u521b\u529e\u4eba\u4e4b\u4e00\uff0c\u6c5f\u897f\u897f\u533b\u5148\u9a71\u3002</li> <li>\u6731\u4ed9\u822b (1888~1968)\uff1a\u957f\u5c71\u664f\u4eba\u3002\u8457\u540d\u7eba\u7ec7\u4e13\u5bb6\uff0c\u4e2d\u56fd\u7eba\u7ec7\u5b66\u4f1a\u53d1\u8d77\u4eba\u4e4b\u4e00\uff0c\u6c5f\u897f\u6c11\u65cf\u7eba\u7ec7\u5de5\u4e1a\u5960\u57fa\u4eba\u3002</li> <li>\u5f90\u6897\u751f (1907~1966)\uff1a\u53bf\u57ce\u4eba\u3002\u7231\u56fd\u6c11\u4e3b\u4eba\u58eb\uff0c\u66fe\u4efb\u674e\u5b97\u4ec1\u79d8\u4e66\uff0c\u53c2\u4e0e\u4fc3\u6210\u5317\u5e73\u548c\u8c08\u3002</li> <li>\u96f7\u6c34\u955c (1896~1978)\uff1a\u4e09\u91cc\u4e61\u4eba\u3002\u8457\u540d\u4e2d\u533b\uff0c\u201c\u6c34\u955c\u5148\u751f\u201d\uff0c\u8457\u4e66\u4e8c\u5343\u4f59\u4e07\u5b57\uff0c\u533b\u5fb7\u9ad8\u5c1a\u3002</li> </ul>"},{"location":"people/#_11","title":"\u9769\u547d\u5148\u70c8\u4e0e\u82f1\u6a21","text":"<p>\u201c\u780d\u5934\u4e0d\u8981\u7d27\uff0c\u53ea\u8981\u4e3b\u4e49\u771f\u3002\u201d\u2014\u2014\u8fdb\u8d24\u5927\u6279\u4ec1\u4eba\u5fd7\u58eb\u4e3a\u9769\u547d\u629b\u5934\u9885\u3001\u6d12\u70ed\u8840\u3002</p>"},{"location":"people/#_12","title":"\u9769\u547d\u65f6\u671f","text":"<ul> <li>\u65b9\u6b63 (1900~1927)\uff1a\u51f0\u5cad\u4eba\u3002\u5927\u9769\u547d\u65f6\u671f\u8fdb\u8d24\u5de5\u519c\u8fd0\u52a8\u9886\u5bfc\u4eba\uff0c1927\u5e748\u6708\u727a\u7272\u3002</li> <li>\u4f55\u9f99\u6069 (1891~1927)\uff1a\u6e29\u5733\u4eba\u3002\u6e29\u5733\u519c\u4f1a\u4e3b\u5e2d\uff0c1927\u5e74\u88ab\u571f\u8c6a\u52a3\u7ec5\u6740\u5bb3\uff0c\u82f1\u52c7\u5c31\u4e49\u3002</li> <li>\u5468\u4ece\u543e (1901~1927)\uff1a\u524d\u9014\u4e61\u4eba\u3002\u65e9\u671f\u5171\u4ea7\u515a\u5458\uff0c1927\u5e74\u5728\u674e\u6e21\u727a\u7272\u3002</li> <li>\u7f57\u65f6\u6709 (1901~1928)\uff1a\u7f57\u6eaa\u4eba\u3002\u6728\u5320\u51fa\u8eab\uff0c1928\u5e74\u727a\u7272\u3002</li> <li>\u9676\u690d\u67f3 (1900~?)\uff1a\u8d75\u57e0\u4eba\u3002\u53c2\u52a0\u4e86\u5357\u660c\u516b\u4e00\u8d77\u4e49\uff0c\u5728\u6218\u6597\u4e2d\u727a\u7272\u3002</li> <li>\u5434\u96f7\u9e23 (1909~?)\uff1a\u8d75\u57e0\u4eba\u3002\u66fe\u5c31\u8bfb\u5fc3\u8fdc\u4e2d\u5b66\uff0c\u540e\u53c2\u52a0\u7ea2\u519b\u727a\u7272\u3002</li> </ul>"},{"location":"people/#_13","title":"\u89e3\u653e\u519b\u5c06\u9886","text":"<ul> <li>\u9f50\u9489\u6839 (1916~1986)\uff1a\u6cc9\u5cad\u4eba\u3002\u5f00\u56fd\u5c11\u5c06\u3002\u53c2\u52a0\u8fc7\u957f\u5f81\u3001\u5e73\u578b\u5173\u6218\u5f79\u3001\u6297\u7f8e\u63f4\u671d\u3002\u66fe\u4efb\u7a7a\u964d\u5175\u7b2c15\u519b\u526f\u519b\u957f\u3002</li> </ul>"},{"location":"people/#_14","title":"\u548c\u5e73\u5e74\u4ee3\u82f1\u6a21","text":"<ul> <li>\u9f50\u4f2f\u826f (1934~1977)\uff1a\u6cc9\u5cad\u4eba\u3002\u94c1\u8def\u5de5\u4eba\uff0c\u4e3a\u62a2\u9669\u6551\u707e\u727a\u7272\uff0c\u8ffd\u8ba4\u4e3a\u9769\u547d\u70c8\u58eb\u3002</li> <li>\u9f9a\u540c\u8fde (1940~1980)\uff1a\u5f20\u516c\u4eba\u3002\u4e3a\u6551\u89e6\u7535\u513f\u7ae5\u727a\u7272\uff0c\u8ffd\u8ba4\u4e3a\u9769\u547d\u70c8\u58eb\u3002</li> <li>\u5085\u6b63\u559c (1947~1980)\uff1a\u524d\u574a\u4eba\u3002\u5728\u6297\u6d2a\u62a2\u9669\u4e2d\u4e3a\u5835\u4f4f\u5729\u5824\u6f0f\u6d1e\u727a\u7272\u3002</li> <li>\u738b\u5efa\u5e73 (1955~1979)\uff1a\u6c60\u6eaa\u4eba\u3002\u5728\u5bf9\u8d8a\u81ea\u536b\u53cd\u51fb\u6218\u4e2d\u5149\u8363\u727a\u7272\uff0c\u8ffd\u8bb0\u4e09\u7b49\u529f\u3002</li> </ul>"}]}