{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"geography/","title":"\u4e8c\u3001\u5730\u7406\u73af\u5883\u7f16","text":""},{"location":"geography/#_2","title":"\u81ea\u7136\u73af\u5883","text":""},{"location":"geography/#_3","title":"\u533a\u4f4d","text":"<p>\u8fdb\u8d24\u53bf\u4f4d\u4e8e\u6c5f\u897f\u7701\u4e2d\u90e8\uff0c\u9131\u9633\u6e56\u5357\u5cb8\uff0c\u629a\u6cb3\u4e0e\u4fe1\u6cb3\u7684\u4e0b\u6e38\u3002\u5730\u7406\u5750\u6807\u662f\u5317\u7eac28\u00b009\u201941\u201d-28\u00b046\u201913\u201d\uff0c\u4e1c\u7ecf116\u00b001\u201915\u201d-116\u00b033\u201938\u201d\u3002\u4e1c\u90bb\u4e1c\u4e61\u53bf\uff0c\u5357\u63a5\u4e34\u5ddd\u533a\uff0c\u897f\u9694\u629a\u6cb3\u4e0e\u4e30\u57ce\u5e02\u3001\u5357\u660c\u53bf\u76f8\u671b\uff0c\u5317\u4ee5\u6768\u574a\u6e56\u3001\u4fe1\u6cb3\u4e3a\u754c\u4e0e\u4f59\u5e72\u53bf\u6bd7\u90bb\u3002\u53bf\u57ce\u6c11\u548c\u9547\uff0c\u8ddd\u5357\u660c\u5e0260\u516c\u91cc\u3002</p>"},{"location":"geography/#_4","title":"\u5730\u8d28\u4e0e\u5730\u8c8c","text":"<p>\u5730\u8d28 \u672c\u53bf\u4ee5\u5143\u53e4\u754c\u53cc\u6865\u5c71\u7fa4\u6784\u6210\u533a\u57df\u8936\u76b1\u57fa\u5e95\uff0c\u7b2c\u56db\u7eaa\u7ea2\u7c98\u571f\u5e7f\u6cdb\u5206\u5e03\u3002\u5168\u53bf\u7531\u7ea2\u58e4\u53d1\u80b2\u7684\u571f\u58e4\u603b\u9762\u79ef\u4e3a12.4\u4e07\u516c\u9877\uff0c\u5360\u5168\u53bf\u9646\u5730\u9762\u79ef\u768481.12%\u3002</p> <p>\u5730\u8c8c \u5168\u53bf\u5730\u8c8c\u7279\u70b9\u5c5e\u4e18\u9675\u6ee8\u6e56\u5730\u533a\u3002\u5730\u52bf\u7531\u4e1c\u5357\u5411\u897f\u5317\u503e\u659c\uff0c\u670916\u4e2a\u6d77\u62d4100\u7c73\u4ee5\u4e0a\u7684\u4f4e\u4e18\u3002\u6700\u9ad8\u5904\u91d1\u5c71\u5cad\u6d77\u62d4256.9\u7c73\uff0c\u6700\u4f4e\u5904\u5317\u90e8\u6e56\u6d32\u6d77\u62d4\u4ec59\u7c73\u3002\u5883\u5185\u5c71\u4e18\u5730\u7ea6\u536025%\uff0c\u6ee8\u6e56\u5730\u533a\u7ea6\u536067%\uff0c\u897f\u90e8\u51b2\u79ef\u5e73\u539f\u7ea6\u53608%\u3002</p>"},{"location":"geography/#_5","title":"\u5c71\u8109\u4e0e\u5c71\u5cf0","text":"<p>\u5168\u53bf\u6d77\u62d460\u7c73\u4ee5\u4e0a\u7684\u5c71\u8109\u8d70\u5411\u5448\u201c\u4e0d\u201d\u5b57\u578b\u5c55\u5e03\uff0c\u6784\u6210\u5730\u5f62\u9aa8\u67b6\u3002 * \u4e3b\u8981\u5c71\u5cf0\uff1a\u5883\u5185\u6709\u91d1\u5c71\u5cad\u3001\u9ebb\u5c71\u5cad\u3001\u6d41\u5cad\u3001\u94dc\u5cad\u3001\u7f57\u5cad\u3001\u7a91\u80cc\u5cad\u3001\u6d6e\u6e38\u5cad\u3001\u4f0f\u5c71\u5cad\u3001\u9999\u7089\u89c2\u3001\u51f0\u5cad\u5c71\u7b4916\u4e2a\u6d77\u62d4100\u7c73\u4ee5\u4e0a\u7684\u4f4e\u4e18\u3002 * \u6700\u9ad8\u5cf0\uff1a\u91d1\u5c71\u5cad\uff0c\u5750\u843d\u5728\u767d\u5729\u4e61\uff0c\u6d77\u62d4256.9\u7c73\u3002</p>"},{"location":"geography/#_6","title":"\u6cb3\u6d41\u4e0e\u6e56\u6cca","text":"<p>\u6cb3\u6d41 * \u4fe1\u6c5f\uff1a\u6d41\u7ecf\u53bf\u5883\u4e1c\u5317\u90e8\uff0c\u897f\u5927\u6cb3\u4e0b\u6e38\u662f\u672c\u53bf\u548c\u4f59\u5e72\u53bf\u7684\u754c\u6cb3\u3002 * \u629a\u6cb3\uff1a\u6d41\u7ecf\u672c\u53bf\u897f\u5357\u90e8\uff0c\u7cfb\u672c\u53bf\u4e0e\u5357\u660c\u3001\u4e34\u5ddd\u7b49\u53bf\u7684\u754c\u6cb3\uff0c\u5883\u5185\u957f\u5ea655\u516c\u91cc\u3002</p> <p>\u6e56\u6cca * \u519b\u5c71\u6e56\uff1a\u672c\u53bf\u6700\u5927\u7684\u6e56\u6cca\uff0c\u5357\u5317\u957f25\u516c\u91cc\uff0c\u4e1c\u897f\u5bbd\u7ea65\u516c\u91cc\uff0c\u76db\u4ea7\u5927\u95f8\u87f9\u3002 * \u9752\u5c9a\u6e56\uff1a\u53c8\u540d\u82f1\u5c71\u6e56\uff0c\u5206\u4e3a\u5185\u3001\u5916\u9752\u5c9a\u6e56\uff0c\u5916\u6e56\u662f\u4e0e\u5357\u660c\u53bf\u7684\u516c\u5171\u754c\u6e56\u3002 * \u9648\u5bb6\u6e56\uff1a\u4f4d\u4e8e\u519b\u5c71\u6e56\u5317\uff0c\u4e0e\u91d1\u6eaa\u6e56\u76f8\u8fde\u3002 * \u91d1\u6eaa\u6e56\uff1a\u4f4d\u4e8e\u8fdb\u8d24\u5317\u7aef\uff0c\u5c5e\u9131\u9633\u6e56\u7684\u4e00\u90e8\u5206\u3002</p>"},{"location":"geography/#_7","title":"\u6c14\u5019\u7279\u5f81","text":"<p>\u8fdb\u8d24\u5c5e\u4e9a\u70ed\u5e26\u5b63\u98ce\u6e7f\u6da6\u6c14\u5019\uff0c\u96e8\u91cf\u5145\u6c9b\uff0c\u56db\u5b63\u5206\u660e\u3002 * \u6c14\u6e29\uff1a\u5e74\u5e73\u5747\u6c14\u6e29\u4e3a17.7\u2103\u3002\u6781\u7aef\u6700\u9ad8\u6c14\u6e2940.5\u2103 (1988\u5e74)\uff0c\u6781\u7aef\u6700\u4f4e\u6c14\u6e29-12.1\u2103 (1991\u5e74)\u3002 * \u964d\u6c34\uff1a\u5168\u5e74\u5e73\u5747\u964d\u6c34\u91cf\u4e3a1591.1\u6beb\u7c73\uff0c4-6\u6708\u4e3a\u6c5b\u671f\uff0c\u5360\u5168\u5e74\u964d\u6c34\u91cf\u768450%\u3002 * \u65e5\u7167\uff1a7\u6708\u4efd\u65e5\u7167\u6700\u591a\uff0c2\u6708\u4efd\u6700\u5c11\u3002 * \u65e0\u971c\u671f\uff1a\u591a\u5e74\u5e73\u5747\u4e3a282\u5929\u3002</p>"},{"location":"geography/#_8","title":"\u81ea\u7136\u707e\u5bb3","text":"<p>\u8fdb\u8d24\u53bf\u4e3b\u8981\u81ea\u7136\u707e\u5bb3\u6709\u6c34\u707e\u3001\u65f1\u707e\u3001\u66b4\u98ce\u3001\u96f9\u707e\u3001\u4f4e\u6e29\u3001\u51b7\u51bb\u7b49\u3002 * \u6c34\u707e\uff1a\u53d1\u751f\u9891\u7387\u8f83\u9ad8\uff0c\u5e73\u57472~3\u5e74\u4e00\u9047\u30021998\u5e74\u7279\u5927\u6d2a\u6d9d\u707e\u5bb3\u76f4\u63a5\u7ecf\u6d4e\u635f\u5931\u8fbe1.95\u4ebf\u5143\u3002 * \u65f1\u707e\uff1a\u591a\u53d1\u751f\u57287\u6708\u4e4b\u540e\uff08\u4f0f\u65f1\u3001\u79cb\u65f1\uff09\u3002 * \u51b0\u96f9\uff1a\u591a\u5728\u6625\u590f\u5b63\u51fa\u73b0\uff0c2021\u5e743\u6708\u66fe\u9020\u6210\u516d\u4e2a\u4e61\u9547\u53d7\u707e\u3002</p>"},{"location":"geography/#_9","title":"\u81ea\u7136\u8d44\u6e90","text":""},{"location":"geography/#_10","title":"\u77ff\u85cf","text":"<ul> <li>\u91d1\u5c5e\u77ff\uff1a\u5206\u5e03\u6709\u8d64\u94c1\u77ff\uff08\u6c60\u6eaa\u3001\u6c11\u548c\uff09\u3001\u9530\u77ff\uff08\u8859\u524d\u3001\u6349\u725b\u5c97\uff09\u3001\u94b4\u77ff\uff08\u949f\u9675\uff09\u3001\u91d1\u77ff\uff08\u6c60\u6eaa\u3001\u8859\u524d\uff09\u7b49\uff0c\u4f46\u591a\u4e3a\u96f6\u661f\u5206\u5e03\u3002</li> <li>\u7164\u77ff\uff1a\u603b\u50a8\u91cf\u7ea6632.8\u4e07\u5428\uff0c\u5206\u5e03\u5728\u949f\u9675\u3001\u6e29\u5733\u7b49\u5730\uff0c\u73b0\u5df2\u591a\u505c\u91c7\u3002</li> </ul>"},{"location":"geography/#_11","title":"\u6c34\u8d44\u6e90","text":"<p>\u5168\u53bf\u6c34\u8d44\u6e90\u4e30\u5bcc\uff0c\u5730\u8868\u6c34\u5e74\u964d\u6c34\u91cf13.8\u4ebf\u7acb\u65b9\u7c73\u3002\u5730\u4e0b\u6c34\u8d28\u4f18\u826f\uff0c20\u4e16\u7eaa90\u5e74\u4ee3\u66fe\u5728\u8305\u5c97\u7b49\u5730\u5f00\u91c7\u77ff\u6cc9\u6c34\u3002</p>"},{"location":"history/","title":"\u4e00\u3001\u653f\u533a\u5efa\u5236\u7f16","text":""},{"location":"history/#_2","title":"\u5386\u53f2","text":""},{"location":"history/#_3","title":"\u91cc\u5c45\u00b7\u574a\u90fd","text":"<p>\u53bf\u57ce\u5341\u4e09\u574a \u53e4\u4ee3\u57ce\u5185\u66f0\u574a\uff0c\u4ea6\u79f0\u516d\u9685\u3002\u5609\u9756\u300a\u53bf\u5fd7\u300b\u8f7d\uff1a\u5728\u57ce\u516d\u9685\uff0c\u4e1c\u9685\u8d24\u884c\u574a\uff0c\u897f\u9685\u4ec1\u884c\u574a\uff0c\u5357\u9685\u79ef\u5584\u574a\uff0c\u5317\u9685\u6298\u6842\u574a\uff0c\u4e2d\u9685\u6e05\u653f\u574a\uff0c\u6b63\u9685\u6c11\u548c\u574a\u3002\u636e\u4e7e\u9686\u300a\u5e9c\u5fd7\u300b\u4e0e\u9053\u5149\u3001\u540c\u6cbb\u300a\u53bf\u5fd7\u300b\u6240\u8f7d\uff0c\u53bf\u57ce\u5206\u4e3a\u5185\u5341\u4e09\u574a\uff1a\u53bf\u6cbb\u5357\u6709\u72b6\u5143\u574a\u3001\u6e05\u653f\u574a\u3001\u79ef\u5584\u574a\u3001\u592a\u5e73\u574a\uff0c\u4e1c\u5357\u6709\u6c11\u548c\u574a\u3001\u8d24\u884c\u574a\u3001\u5927\u6210\u574a\u3001\u4ec1\u5bff\u574a\uff0c\u897f\u5357\u6709\u7530\u6d3d\u574a\uff0c\u5317\u6709\u4e49\u7acb\u574a\u3001\u4e1c\u5317\u6709\u6298\u6842\u574a\uff0c\u897f\u6709\u4ec1\u4e49\u574a\u3001\u4ec1\u884c\u574a\u3002</p> <p>\u8857\u5e02 \u53bf\u57ce\u4e2d\u9053\u8def\uff0c\u7686\u79f0\u4e3a\u8857\u5e02\u3002\u540c\u6cbb\u300a\u53bf\u5fd7\u300b\u8f7d\u53bf\u57ce\u4e2d\u8857\u5e02\u6709\u4e2d\u5927\u8857\u3001\u4e1c\u9854\u8857\u3001\u592a\u5e73\u5df7\u8857\u3001\u5357\u957f\u8857\u3001\u540e\u8857\u3001\u96fe\u5cad\u8857\u3001\u5c11\u5e9c\u6865\u8857\u3001\u82b1\u5df7\u53e3\u8857\u3001\u5b66\u524d\u8857\u3001\u9053\u524d\u8857\u3001\u9a6c\u5bb6\u5df7\u8857\u3001\u82cf\u5bb6\u89d2\u8857\u3001\u6cb3\u95e8\u8857\u3001\u4e2d\u6d32\u8857\u3001\u524d\u6d32\u8857\u3001\u6309\u5bdf\u53f8\u524d\u8857\u5341\u516d\u6761\u8857\u5e02\u3002</p> <p>\u53bf\u5e02 \u540c\u6cbb\u300a\u53bf\u5fd7\u300b\u8f7d\u53bf\u57ce\u56db\u95e8\u5916\u8fd8\u6709\u591a\u4e2a\u8857\u5e02\uff1a\u542f\u548c\u95e8\u5916\u6709\u4e1c\u95e8\u53e3\u5e02\u3001\u79be\u4e86\u53e3\u5e02\u3001\u4e1c\u5173\u8857\u3001\u6349\u725b\u5188\u5e02\u3001\u6c60\u6eaa\u6865\u5e02\u3001\u5357\u9633\u5e02\u3001\u5357\u53f0\u5e02\u3001\u6da6\u6eaa\u5e02\u3001\u6768\u6865\u5e02\u3001\u953a\u9675\u6865\u5e02\u3001\u6f6d\u6d25\u5e02\u3001\u6885\u5e84\u5e02\u3002\u62f1\u6781\u95e8\u5916\u6709\u540e\u6d32\u8857\u3001\u4e03\u91cc\u5188\u5e02\u3001\u820d\u6e90\u5e02\u3001\u8d75\u5bb6\u94fa\u5e02\u3001\u4e09\u9633\u5e02\u3001\u6cfe\u53e3\u65b0\u589f\u5e02\u3001\u5e84\u6eaa\u5e02\u3002\u8fce\u6069\u95e8\u5916\u6709\u7f57\u6eaa\u5e02\u3001\u7389\u5cad\u5e02\u3001\u571f\u574a\u5e02\u3001\u9ec4\u8305\u5188\u5e02\u3002\u7530\u6d3d\u95e8\u5916\u6709\u5f20\u516c\u589f\u5e02\u3001\u767d\u5bb6\u589f\u5e02\u3001\u6728\u67b6\u589f\u5e02\u3001\u4e0b\u57e0\u589f\u5e02\u3002</p> <p>\u90fd\u56fe \u53bf\u57ce\u5916\u66f0\u4e61\uff0c\u6240\u8f96\u4e3a\u90fd\uff0c\u90fd\u4e0b\u8bbe\u56fe\u3002\u5317\u5b8b\u5d07\u5b81\u4e8c\u5e74\uff081103\uff09\uff0c\u7531\u5357\u660c\u53bf\u5212\u5f52\u4ec1\u3001\u5d07\u793c\u3001\u5d07\u4fe1\u3001\u771f\u9690\u56db\u4e61\u548c\u65b0\u5efa\u53bf\u7389\u6eaa\u3001\u4e1c\u897f\u4e8c\u4e61\u5212\u5f52\u8bbe\u7acb\u8fdb\u8d24\u3002\u5317\u5b8b\u5927\u89c2\u4e8c\u5e74\uff081108\uff09\u5c06\u65b0\u5efa\u4e8c\u4e61\u5f52\u8fd8\uff0c\u7531\u5357\u660c\u5212\u94a6\u98ce\u4e61\u8865\u5145\u3002\u8fdb\u8d24\u53bf\u8f96\u4e94\u4e61\uff0c\u4e09\u5341\u516b\u90fd\uff0c\u4e09\u767e\u516d\u5341\u4e00\u56fe\u3002\u660e\u6b66\u5b97\u5e74\u95f4\u6210\u7acb\u4e1c\u4e61\u53bf\u6cbb\uff0c\u4ece\u8fdb\u8d24\u5212\u51fa\u5341\u4e5d\u90fd\u3001\u4e8c\u5341\u90fd\u3001\u4e8c\u5341\u4e00\u90fd\u7ed9\u4e1c\u4e61\u53bf\uff0c\u8fdb\u8d24\u5b9e\u6709\u4e94\u4e61\u3001\u4e09\u5341\u4e94\u90fd\uff0c\u4e09\u767e\u4e09\u5341\u56fe\u3002\u8fd9\u79cd\u5efa\u5236\u4e00\u76f4\u5ef6\u81f3\u6e05\u672b\u6c11\u521d\u3002\u6c11\u56fd\u4e8c\u5341\u4e8c\u5e74\uff081933\uff09\u5f00\u59cb\u5b9e\u884c\u4fdd\u7532\u5236\u5ea6\uff0c\u53bf\u4e0b\u8bbe\u533a\uff0c\u533a\u4e0b\u8bbe\u4fdd\uff0c\u4fdd\u4e0b\u8bbe\u7532\u3002\u56fd\u6c11\u653f\u5e9c\u89c4\u5b9a\uff0c\u6bcf\u4fdd\u4e0d\u5c11\u4e8e\u516d\u7532\uff0c\u4e0d\u8d85\u8fc7\u5341\u4e94\u6237\u3002\u5168\u53bf\u5171\u5206\u56db\u533a\uff0c\u4e8c\u767e\u4e5d\u5341\u4e5d\u4fdd\uff0c\u4e09\u5343\u56db\u767e\u4e03\u5341\u4e09\u7532\u3002</p>"},{"location":"history/#_4","title":"\u653f\u6743\u00b7\u515a\u6d3e","text":""},{"location":"history/#_5","title":"\u53bf\u8859","text":"<p>\u8003\u65e7\u5fd7\uff0c\u8fdb\u8d24\u53bf\u5efa\u7f72\u4e8e\u5b8b\u671d\uff0c\u5efa\u57ce\u4e8e\u660e\u4ee3\u3002\u53bf\u65e7\u65e0\u57ce\u6c60\uff0c\u81f3\u660e\u6b63\u5fb7\u4e94\u5e74(1510)\u5f00\u59cb\u4fee\u7b51\u57ce\u5899\uff0c\u81f3\u516b\u5e74(1513)\u7b51\u5b8c\u571f\u57ce\u3002\u660e\u6e05\u65f6\uff0c\u53bf\u7f72\u8859\u95e8\u4f4d\u4e8e\u62a4\u57ce\u6cb3\u5317\u7684\u540e\u5c97\u6d32\uff0c\u5730\u5904\u4eca\u5317\u95e8\u6865\u5934\u81f3\u4e94\u91cc\u57a6\u6b96\u573a\u4e00\u5e26\u3002\u6c11\u56fd\u65f6\u5728\u6b64\u5efa\u9020\u4e86\u4e2d\u5c71\u7eaa\u5ff5\u5802\uff0c\u6c11\u56fd\u53bf\u653f\u5e9c\u66fe\u642c\u8fc1\u81f3\u6b64\u3002\u6297\u65e5\u6218\u4e89\u65f6\u88ab\u70b8\u6210\u5e9f\u589f\u3002</p>"},{"location":"history/#_6","title":"\u804c\u5b98","text":"<ul> <li>\u660e\u4ee3\uff1a\u8bbe\u77e5\u53bf\u4e00\u4eba\uff0c\u6b63\u4e03\u54c1\uff0c\u6708\u4ff8\u4e03\u77f3\u4e94\u6597\u3002\u53bf\u4e1e\u4e00\u4eba\uff0c\u6b63\u516b\u54c1\uff0c\u6708\u4ff8\u516d\u77f3\u4e94\u6597\u3002\u5112\u5b66\u6559\u8c15\u4e00\u4eba\uff0c\u8bad\u5bfc\u4e8c\u4eba\uff0c\u4ff1\u672a\u5165\u6d41\uff0c\u6708\u4ff8\u4e09\u77f3\u3002\u4e3b\u7c3f\u4e00\u4eba\uff0c\u6b63\u4e5d\u54c1\uff0c\u6708\u4ff8\u4e94\u77f3\u4e94\u6597\u3002\u5178\u53f2\u4e00\u4eba\uff0c\u672a\u5165\u6d41\uff0c\u6708\u4ff8\u4e09\u77f3\u3002</li> <li>\u6e05\u4ee3\uff1a\u8bbe\u77e5\u53bf\u4e00\u5458\uff0c\u6b63\u4e03\u54c1\uff0c\u4ff8\u94f6\u56db\u5341\u4e94\u4e24\uff0c\u96cd\u6b63\u516d\u5e74\uff081728\u5e74\uff09\u589e\u517b\u5ec9\u94f6\u4e00\u5343\u4e8c\u767e\u4e24\u3002\u53bf\u4e1e\u4e00\u5458\uff0c\u6b63\u516b\u54c1\uff0c\u4ff8\u94f6\u56db\u5341\u4e24\u3002</li> </ul>"},{"location":"history/#_7","title":"\u53bf\u516c\u7f72","text":"<p>\u6c11\u56fd\u6210\u7acb\uff0c\u6539\u79f0\u201c\u77e5\u53bf\u201d\u4e3a\u201c\u53bf\u77e5\u4e8b\u201d\uff0c\u6539\u79f0\u201c\u53bf\u8859\u201d\u4e3a\u201c\u53bf\u516c\u7f72\u201d\u3002\u521d\u671f\uff0c\u53bf\u516c\u7f72\u7684\u7ec4\u7ec7\uff0c\u8f83\u4e3a\u7b80\u964b\u7684\uff0c\u53bf\u516c\u7f72\u5185\uff0c\u9664\u53bf\u77e5\u4e8b\u5916\uff0c\u6240\u7528\u7686\u4e3a\u5e55\u50da\u3002\u5317\u4f10\u6210\u529f\u540e\uff0c\u201c\u53bf\u77e5\u4e8b\u201d\u6539\u79f0\u4e3a\u201c\u53bf\u957f\u201d\uff0c\u201c\u53bf\u516c\u7f72\u201d\u6539\u79f0\u4e3a\u201c\u53bf\u653f\u5e9c\u3002\u201d</p>"},{"location":"history/#_8","title":"\u884c\u653f\u533a\u5212","text":"<p>\u5386\u53f2\u6cbf\u9769 \u5b8b\u5d07\u5b81\u4e8c\u5e74\uff081103\uff09\uff0c\u81ea\u5357\u660c\u53bf\u5212\u51fa\u5f52\u4ec1\u3001\u5d07\u793c\u3001\u5d07\u4ec1\u3001\u771f\u9690\u56db\u4e61\uff0c\u53ca\u65b0\u5efa\u53bf\u5212\u51fa\u7389\u6eaa\u4e1c\u3001\u7389\u6eaa\u897f\u4e8c\u4e61\uff0c\u5347\u8fdb\u8d24\u9547\u4e3a\u8fdb\u8d24\u53bf\u3002\u5317\u5b8b\u5927\u89c2\u4e8c\u5e74\uff081108\u5e74\uff09\uff0c\u5c06\u7389\u6eaa\u4e1c\u3001\u7389\u6eaa\u897f\u5f52\u8fd8\u65b0\u5efa\uff0c\u7531\u5357\u660c\u5212\u94a6\u98ce\u4e61\u8865\u4e4b\u3002\u4e61\u4e0b\u6709\u90fd\uff0c\u90fd\u4e0b\u8bbe\u56fe\uff0c\u8fdb\u8d24\u8bbe5\u4e6138\u90fd243\u56fe\u3002</p> <p>\u533a\u57df\u52d8\u754c 1996\u5e74\u56fd\u52a1\u9662\u542f\u52a8\u5168\u56fd\u7701\u3001\u53bf\u4e24\u7ea7\u884c\u653f\u533a\u57df\u754c\u7ebf\u52d8\u5b9a\u5de5\u7a0b\u30021999\u5e74\u5b8c\u6210\u4e0e\u629a\u5dde\u4e1c\u4e61\u53bf\uff08\u73b0\u4e1c\u4e61\u533a\uff09\u8fb9\u754c\u534f\u8bae\u30022018\u5e74\u4f9d\u636e\u300a\u5357\u660c\u5e02\u884c\u653f\u533a\u5212\u56fe\u96c6\u300b\uff082018\u7248\uff09\u66f4\u65b0\u6570\u5b57\u5316\u8fb9\u754c\u3002\u73b0\u8fb9\u754c\u56db\u81f3\uff1a\u4e1c\u4e0e\u629a\u5dde\u5e02\u4e1c\u4e61\u533a\u3001\u4e34\u5ddd\u533a\u63a5\u58e4\uff0c\u4ee5\u629a\u6cb3\u6545\u9053\u4e3a\u5929\u7136\u754c\u6cb3\uff1b\u5357\u6bd7\u90bb\u629a\u5dde\u5e02\u4e34\u5ddd\u533a\u3001\u4e30\u57ce\u5e02\uff0c\u4ee5\u91d1\u5c71\u5cad\u5c71\u8109\u5206\u6c34\u5cad\u4e3a\u754c\uff1b\u897f\u63a5\u5357\u660c\u5e02\u5357\u660c\u53bf\u3001\u9752\u5c71\u6e56\u533a\uff0c\u6cbf\u4fe1\u6c5f\u897f\u652f\u6d41\u4e2d\u5fc3\u7ebf\u5212\u5206\uff1b\u5317\u90bb\u9131\u9633\u6e56\u6c34\u57df\u3002</p>"},{"location":"history/#_9","title":"\u91cd\u70b9\u4e61\u9547\u4ecb\u7ecd","text":"<ul> <li>\u6c11\u548c\u9547\uff1a\u8fdb\u8d24\u53bf\u7684\u57ce\u5173\u9547\uff0c\u4e3a\u53bf\u6cbb\u6240\u5728\u5730\uff0c\u5386\u6765\u662f\u8fdb\u8d24\u7684\u653f\u6cbb\u3001\u7ecf\u6d4e\u3001\u6587\u5316\u4e2d\u5fc3\u30022024\u5e74\u64a4\u9500\u6c11\u548c\u9547\uff0c\u6790\u8bbe\u6c11\u548c\u8857\u9053\u3001\u4e91\u6865\u8857\u9053\u3002</li> <li>\u674e\u6e21\u9547\uff1a\u5343\u5e74\u53e4\u9547\uff0c\u662f\u201c\u6c5f\u5357\u9152\u4e61\u201d\u3001\u201c\u6bdb\u7b14\u4e4b\u4e61\u201d\u3001\u201c\u590f\u5e03\u4e4b\u4e61\u201d\uff0c\u66fe\u4e0e\u666f\u5fb7\u9547\u3001\u9e70\u6f6d\u3001\u6a1f\u6811\u9f50\u540d\uff0c\u5e76\u79f0\u201c\u6c5f\u897f\u56db\u5927\u540d\u9547\u201d\u3002</li> <li>\u6587\u6e2f\u9547\uff1a\u4ee5\u5236\u7b14\u53ca\u76f8\u5173\u6587\u5316\u7528\u54c1\u4ea7\u4e1a\u4e3a\u6838\u5fc3\uff0c\u7d20\u6709\u201c\u534e\u590f\u7b14\u90fd\u201d\u4e4b\u79f0\u3002</li> </ul>"}]}